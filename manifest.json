{
  "manifest_version": 3,
  "name": "Reflect \u2014 LeetCode connection",
  "version": "0.5.1",
  "description": "Read your last year of submissions from your signed-in LeetCode tab and analyze them locally.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "action": {
    "default_title": "Open Reflect"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "extension/content/sync.js",
        "extension/content/ai-context.js"
      ]
    }
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1/*"
  ]
}
